# .streamlit/secrets.toml.example
# ---------------------------------
# Template for Streamlit secrets.
#
# FOR LOCAL DEVELOPMENT:
#   Copy this file to .streamlit/secrets.toml and fill in your real values.
#   .streamlit/secrets.toml is excluded by .gitignore — never commit it.
#
# FOR STREAMLIT COMMUNITY CLOUD:
#   Do NOT upload this file. Instead, paste each key-value pair directly into
#   your app's Settings → Secrets panel on share.streamlit.io.
#
# Never commit or share a file that contains real credentials.

WATSONX_API_KEY    = "your_ibm_cloud_api_key_here"
WATSONX_PROJECT_ID = "your_watsonx_project_id_here"
WATSONX_URL        = "https://us-south.ml.cloud.ibm.com"
WATSONX_MODEL_ID   = "ibm/granite-4-h-small"
